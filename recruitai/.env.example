# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AI CV scoring (https://console.anthropic.com → API keys). Required.
ANTHROPIC_API_KEY=
# Optional: cheaper model, e.g. claude-sonnet-5-5 (default claude-opus-5-5)
# SCORING_MODEL=
# Optional: 1 = log full CV text, AI prompts and raw responses (personal data!)
# SCORING_DEBUG=
